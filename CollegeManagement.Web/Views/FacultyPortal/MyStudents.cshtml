@model IEnumerable<FoodSafety.Domain.Entities.CourseEnrolment>

@{
    ViewData["Title"] = "My Students";
}

<h1>My Students</h1>

<table class="table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Email</th>
            <th>Course</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentProfile?.Name</td>
                <td>@item.StudentProfile?.Email</td>
                <td>@item.Course?.Name</td>
                <td>@item.Status</td>
            </tr>
        }
    </tbody>
</table>