@model IEnumerable<CollegeManagement.Domain.Entities.ExamResult>

@{
    ViewData["Title"] = "Exam Results";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Exam Results</h1>
        <p class="text-light mb-0">
            Review student exam scores and grades.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Result
    </a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Student</th>
                <th>Exam</th>
                <th>Score</th>
                <th>Grade</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>
                            @(item.StudentProfile?.Name ?? "Unknown student")
                        </strong>

                        <div class="small text-muted">
                            @(item.StudentProfile?.Email ?? "")
                        </div>
                    </td>

                    <td>
                        @(item.Exam?.Title ?? "Unknown exam")
                    </td>

                    <td>
                        <strong>@item.Score.ToString("0.##")</strong>
                        /
                        @(item.Exam?.MaxScore.ToString("0.##") ?? "—")
                    </td>

                    <td>
                        <span class="badge bg-secondary">
                            @(item.Grade ?? "Not graded")
                        </span>
                    </td>

                    <td class="text-end text-nowrap">
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-success">
                            View
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>