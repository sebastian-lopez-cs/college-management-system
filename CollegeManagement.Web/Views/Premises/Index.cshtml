@model IEnumerable<CollegeManagement.Domain.Entities.Premises>

@{
    ViewData["Title"] = "Premises";
}

<h1>Premises</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Premises</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Town</th>
            <th>Business Type</th>
            <th>Risk Rating</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Town</td>
                <td>@item.BusinessType</td>
                <td>@item.RiskRating</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
