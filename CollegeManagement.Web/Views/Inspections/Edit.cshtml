@model CollegeManagement.Domain.Entities.Inspection

@{
    ViewData["Title"] = "Edit Inspection";
}

<h1>Edit Inspection</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="PremisesId" class="form-label">Premises</label>
                <select asp-for="PremisesId" class="form-select" asp-items="ViewBag.PremisesId"></select>
                <span asp-validation-for="PremisesId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InspectionDate" class="form-label"></label>
                <input asp-for="InspectionDate" class="form-control" type="date" />
                <span asp-validation-for="InspectionDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InspectorName" class="form-label"></label>
                <input asp-for="InspectorName" class="form-control" />
                <span asp-validation-for="InspectorName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HygieneScore" class="form-label"></label>
                <input asp-for="HygieneScore" class="form-control" />
                <span asp-validation-for="HygieneScore" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Outcome" class="form-label"></label>
                <select asp-for="Outcome" class="form-select" asp-items="Html.GetEnumSelectList<CollegeManagement.Domain.Enums.InspectionOutcome>()"></select>
                <span asp-validation-for="Outcome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
