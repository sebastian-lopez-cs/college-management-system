@model IEnumerable<CollegeManagement.Domain.Entities.Inspection>

@{
    ViewData["Title"] = "Inspections";
}

<h1>Inspections</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Inspection</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Premises</th>
            <th>Date</th>
            <th>Inspector</th>
            <th>Score</th>
            <th>Outcome</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Premises?.Name</td>
                <td>@item.InspectionDate.ToShortDateString()</td>
                <td>@item.InspectorName</td>
                <td>@item.HygieneScore</td>
                <td>@item.Outcome</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>