@model FoodSafety.Domain.Entities.Inspection

@{
    ViewData["Title"] = "Inspection Details";
}

<h1>Inspection Details</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Premises</dt>
    <dd class="col-sm-9">@Model.Premises?.Name</dd>

    <dt class="col-sm-3">Inspection Date</dt>
    <dd class="col-sm-9">@Model.InspectionDate.ToShortDateString()</dd>

    <dt class="col-sm-3">Inspector</dt>
    <dd class="col-sm-9">@Model.InspectorName</dd>

    <dt class="col-sm-3">Hygiene Score</dt>
    <dd class="col-sm-9">@Model.HygieneScore</dd>

    <dt class="col-sm-3">Outcome</dt>
    <dd class="col-sm-9">@Model.Outcome</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@Model.Notes</dd>
</dl>

@if (Model.FollowUps != null && Model.FollowUps.Any())
{
    <h4>Follow Ups</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Action Required</th>
                <th>Due Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.FollowUps)
            {
                <tr>
                    <td>@item.ActionRequired</td>
                    <td>@item.DueDate.ToShortDateString()</td>
                    <td>@item.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>