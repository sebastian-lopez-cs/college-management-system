@model IEnumerable<CollegeManagement.Domain.Entities.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Courses</h1>
        <p class="text-light mb-0">
            Manage academic courses, schedules, and branch assignments.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Course
    </a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Course</th>
                <th>Branch</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Name</strong>
                    </td>

                    <td>
                        @(item.Branch?.Name ?? "Not assigned")
                    </td>

                    <td>
                        @item.StartDate.ToString("dd MMM yyyy")
                    </td>

                    <td>
                        @item.EndDate.ToString("dd MMM yyyy")
                    </td>

                    <td class="text-end text-nowrap">
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-success">
                            View
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>