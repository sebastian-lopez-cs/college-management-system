@model CollegeManagement.Domain.Entities.FollowUp

@{
    ViewData["Title"] = "Edit Follow Up";
}

<h1>Edit Follow Up</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="InspectionId" class="form-label">Inspection</label>
                <select asp-for="InspectionId" class="form-select" asp-items="ViewBag.InspectionId"></select>
                <span asp-validation-for="InspectionId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ActionRequired" class="form-label"></label>
                <input asp-for="ActionRequired" class="form-control" />
                <span asp-validation-for="ActionRequired" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" class="form-control" type="date" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CompletedDate" class="form-label"></label>
                <input asp-for="CompletedDate" class="form-control" type="date" />
                <span asp-validation-for="CompletedDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<CollegeManagement.Domain.Enums.FollowUpStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}