@model IEnumerable<CollegeManagement.Domain.Entities.CourseEnrolment>

@{
    ViewData["Title"] = "Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Enrolments</h1>
        <p class="text-light mb-0">
            Manage student course enrolments and enrolment status.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Enrolment
    </a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Student</th>
                <th>Course</th>
                <th>Enrolment Date</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@(item.StudentProfile?.Name ?? "Unknown student")</strong>
                        <div class="small text-muted">
                            @(item.StudentProfile?.Email ?? "")
                        </div>
                    </td>

                    <td>
                        @(item.Course?.Name ?? "Unknown course")
                    </td>

                    <td>
                        @item.EnrolDate.ToString("dd MMM yyyy")
                    </td>

                    <td>
                        <span class="badge bg-success">
                            @item.Status
                        </span>
                    </td>

                    <td class="text-end text-nowrap">
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-success">
                            View
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>