@model IEnumerable<CollegeManagement.Domain.Entities.CourseEnrolment>

@{
    ViewData["Title"] = "My Enrolments";
}

<h1>My Enrolments</h1>

<table class="table">
    <thead>
        <tr>
            <th>Course</th>
            <th>Branch</th>
            <th>Enrol Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Course?.Name</td>
                <td>@item.Course?.Branch?.Name</td>
                <td>@item.EnrolDate.ToShortDateString()</td>
                <td>@item.Status</td>
            </tr>
        }
    </tbody>
</table>