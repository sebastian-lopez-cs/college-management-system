@model IEnumerable<CollegeManagement.Domain.Entities.Assignment>

@{
    ViewData["Title"] = "Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Assignments</h1>
        <p class="text-light mb-0">
            Manage coursework, deadlines, and assessment scores.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Assignment
    </a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Assignment</th>
                <th>Course</th>
                <th>Due Date</th>
                <th>Maximum Score</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Title</strong>
                    </td>

                    <td>
                        @(item.Course?.Name ?? "Unknown course")
                    </td>

                    <td>
                        @item.DueDate.ToString("dd MMM yyyy")
                    </td>

                    <td>
                        @item.MaxScore.ToString("0.##")
                    </td>

                    <td class="text-end text-nowrap">
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-success">
                            View
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>