@model IEnumerable<FoodSafety.Domain.Entities.FollowUp>

@{
    ViewData["Title"] = "Follow Ups";
}

<h1>Follow Ups</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Follow Up</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Premises</th>
            <th>Inspection Date</th>
            <th>Action Required</th>
            <th>Due Date</th>
            <th>Completed Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Inspection?.Premises?.Name</td>
                <td>@item.Inspection?.InspectionDate.ToShortDateString()</td>
                <td>@item.ActionRequired</td>
                <td>@item.DueDate.ToShortDateString()</td>
                <td>@(item.CompletedDate?.ToShortDateString() ?? "-")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    @if (item.Status != FoodSafety.Domain.Enums.FollowUpStatus.Closed)
                    {
                        <text> | </text>
                
                        <a asp-action="Close" asp-route-id="@item.Id">Close</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>