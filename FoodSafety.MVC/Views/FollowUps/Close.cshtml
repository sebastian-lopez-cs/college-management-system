@model FoodSafety.Domain.Entities.FollowUp

@{
    ViewData["Title"] = "Close Follow Up";
}

<h1>Close Follow Up</h1>

<h3>Confirm closure of this follow-up?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-3">Premises</dt>
    <dd class="col-sm-9">@Model.Inspection?.Premises?.Name</dd>

    <dt class="col-sm-3">Action Required</dt>
    <dd class="col-sm-9">@Model.ActionRequired</dd>

    <dt class="col-sm-3">Due Date</dt>
    <dd class="col-sm-9">@Model.DueDate.ToShortDateString()</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Close">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-success">Confirm Close</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>