@model FoodSafety.Domain.Entities.StudentProfile

@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>

<table class="table">
    <tr><th>Name</th><td>@Model.Name</td></tr>
    <tr><th>Email</th><td>@Model.Email</td></tr>
    <tr><th>Phone</th><td>@Model.Phone</td></tr>
    <tr><th>Address</th><td>@Model.Address</td></tr>
    <tr><th>Student Number</th><td>@Model.StudentNumber</td></tr>
    <tr><th>Date of Birth</th><td>@Model.DOB?.ToShortDateString()</td></tr>
</table>