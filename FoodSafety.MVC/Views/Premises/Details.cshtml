@model FoodSafety.Domain.Entities.Premises

@{
    ViewData["Title"] = "Premises Details";
}

<h1>Premises Details</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.AddressLine1</dd>

    <dt class="col-sm-3">Town</dt>
    <dd class="col-sm-9">@Model.Town</dd>

    <dt class="col-sm-3">Eircode</dt>
    <dd class="col-sm-9">@Model.Eircode</dd>

    <dt class="col-sm-3">Business Type</dt>
    <dd class="col-sm-9">@Model.BusinessType</dd>

    <dt class="col-sm-3">Risk Rating</dt>
    <dd class="col-sm-9">@Model.RiskRating</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>