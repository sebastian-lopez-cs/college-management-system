@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h1 class="mb-4 text-light">Admin Dashboard</h1>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Branches</h5>
                    <p class="card-text text-dark">Manage college branches.</p>
                    <a asp-controller="Branches" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Courses</h5>
                    <p class="card-text text-dark">Manage courses.</p>
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Students</h5>
                    <p class="card-text text-dark">Manage student profiles.</p>
                    <a asp-controller="StudentProfiles" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Faculty</h5>
                    <p class="card-text text-dark">Manage faculty profiles.</p>
                    <a asp-controller="FacultyProfiles" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Enrolments</h5>
                    <p class="card-text text-dark">Manage enrolments.</p>
                    <a asp-controller="CourseEnrolments" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Attendance</h5>
                    <p class="card-text text-dark">Track attendance.</p>
                    <a asp-controller="AttendanceRecords" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Assignments</h5>
                    <p class="card-text text-dark">Manage assignments.</p>
                    <a asp-controller="Assignments" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Assignment Results</h5>
                    <p class="card-text text-dark">Manage assignment results.</p>
                    <a asp-controller="AssignmentResults" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Exams</h5>
                    <p class="card-text text-dark">Manage exams.</p>
                    <a asp-controller="Exams" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-dark">Exam Results</h5>
                    <p class="card-text text-dark">Manage exam results.</p>
                    <a asp-controller="ExamResults" asp-action="Index" class="btn btn-success">Open</a>
                </div>
            </div>
        </div>
    </div>
</div>